# Generated fixture git repos (seeded by scripts/seed_*.py).
# Fixture working trees are tracked so tests reproduce from a clean checkout;
# only their generated .git directories, capture stores, and the external
# swebench django clone (a Windows junction into the artifact cache) are
# excluded.
fixtures/*/.git/
fixtures/*/.agent-memory/
fixtures/swebench_repo/
fixtures/toy_repo/.git/
fixtures/history_repo/.git/
fixtures/deps_repo/.git/
fixtures/iface_repo/.git/
fixtures/creds_repo/.git/
fixtures/pager_repo/.git/
fixtures/net_repo/.git/
fixtures/data_repo/.git/
fixtures/api_repo/.git/
fixtures/queue_repo/.git/
fixtures/profiles_repo/.git/
fixtures/cache_repo/.git/
fixtures/store_repo/.git/

